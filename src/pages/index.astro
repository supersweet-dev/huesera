---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import Arrabel from '../components/Arrabel.astro';
---

<BaseLayout>
	<header class="hero">
		<div class="overlay">
			<Logo color="var(--white)" />
			<p class="tagline">pedacitos y piececitas</p>
			<div class="cta">
				<a href="https://huesera.eo.page/" class="button">Subscribe</a>
			</div>
		</div>
	</header>

	<main>
		<h1 class="issue-title">WE KNOW WHAT WE DID THIS SUMMER</h1>

		<section class="intro">
			<p>
				Huesera is a project from Gem and Hideki to help our circle rely
				less on social media for updates by creating a space to showcase
				everyone's news, art, and interests.
			</p>
			<br />
			<p><i>No quiero enterarme de nada hoy / así es el calor</i></p>
			<p>
				Our magazine debuts with a summer issue, closing out the season
				with memories of rest and relaxation. Did you have a good time?
				Did you have a bad time? Did you travel the world? Or did you
				make your own refuge? How did you combat the sweltering heat? We
				want to hear all about it.
			</p>
		</section>

		<section id="calls" class="calls">
			<h2>Calls for Submissions</h2>
			<h3 class="due">Deadline 09/28/2025</h3>
			<p>
				Submissions can range from a few sentences to include in our
				compilations or a full multi-page article. Feel free to send in
				multiple submissions! If you have any specific formatting
				requests please let us know. Contributors will be sent a proof
				of their sections on 09/30 for final approval and revisions.
			</p>
			<p>
				Email submissions to
				<a href="mailto:huesera@mapachillo.space"
					>huesera@mapachillo.space</a
				>
			</p>
			<br />
			<article>
				<h3>FEATURED - SUMMER MEMORIES</h3>
				<p>
					Share photos and text about your summer. It can be just
					photos, just text, or both!
				</p>
			</article>
			<article>
				<h3>SUMMER JAMS</h3>
				<p>
					<a
						href="https://open.spotify.com/playlist/3PdZSECaujFTS5Jq6eJu0Q?si=JUxvXSVWTAiig-6pvA4BoA&pi=iJ6cU-qESAa8I&pt=4078d59ca5580c80bf1434c33ca7128e "
						>Add your sounds of summer to the official Huesera
						WKWWDTS playlist!</a
					>
				</p>
			</article>

			<article>
				<h3>ARTS</h3>
				<p>Photos, drawings, poems, in-depth media reviews.</p>
			</article>

			<article>
				<h3>FOR FUN RESEARCH</h3>
				<p>
					Share an article about a research rabbit hole you've
					explored.
				</p>
			</article>

			<article>
				<h3>FITNESS</h3>
				<p>
					Ran, lifted, or achieved a goal? Send us your fitness
					updates.
				</p>
			</article>

			<article>
				<h3>FOOD</h3>
				<p>
					Cooked something delicious or visited a great restaurant?
					Tell us!
				</p>
			</article>

			<article>
				<h3>PERSONAL</h3>
				<p>
					Moving, changing jobs, or celebrating milestones? Share your
					news.
				</p>
			</article>
		</section>
		<section class="media"><Arrabel color="var(--black)" /></section>
	</main>

	<footer>
		<p>© 2025 Huesera</p>
	</footer>
</BaseLayout>
