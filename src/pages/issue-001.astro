---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import Arrabel from '../components/Arrabel.astro';
---

<BaseLayout>
	<header class="hero">
		<div class="overlay">
			<Logo color="var(--white)" />
			<p class="tagline">pedacitos y piececitas</p>
			<div class="cta">
				<a href="/" class="button standard">return</a>
			</div>
		</div>
	</header>

	<main>
		<h1 class="issue-title">WE KNOW WHAT WE DID THIS SUMMER</h1>
		<iframe
			allowfullscreen="allowfullscreen"
			allow="clipboard-write"
			class="fp-iframe"
			src="https://heyzine.com/flip-book/ae9a4c7cc2.html"
			style="border: 1px solid lightgray; width: 100%; height: 400px;"
		></iframe>
	</main>

	<footer>
		<p>© 2025 Huesera</p>
	</footer>
</BaseLayout>
